# Gordon Phase B fixture: schedule row + omni route (schedule is unmounted in
# the shipped rc.2 composition; this overlay mounts it for G6-11).
- insert:
    - id: schedule
      name: '@deepseek-ai/dsh-schedule'

- id: llm-pi-ai
  config:
    providers:
      omniroute:
        displayName: OmniRoute (HX qualification route)
        apiKeyEnv: __KEY_ENV__
        api: openai-completions
        baseURL: __BASE_URL__
        compat:
          supportsDeveloperRole: false
          maxTokensField: max_tokens
        retryPolicy:
          mode: normal
          maxRetries: __MAX_RETRIES__
        models:
__MODELS_YAML__

- id: agent-default-model
  config:
    provider: omniroute
    model: __MODEL_ID__
