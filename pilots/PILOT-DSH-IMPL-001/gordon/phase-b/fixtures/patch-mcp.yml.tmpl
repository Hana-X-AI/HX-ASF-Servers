# Gordon Phase B fixture: mcp-client row against the repo's own stdio fixture
# server (mcp/mcp-client/tests/fixture-server.ts) + omni route.
- insert:
    - id: mcp-fixture
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: fixture
        command: __NODE__
        args: ['__MCP_FIXTURE__']

- id: llm-pi-ai
  config:
    providers:
      omniroute:
        displayName: OmniRoute (HX qualification route)
        apiKeyEnv: __KEY_ENV__
        api: openai-completions
        baseURL: __BASE_URL__
        compat:
          supportsDeveloperRole: false
          maxTokensField: max_tokens
        retryPolicy:
          mode: normal
          maxRetries: __MAX_RETRIES__
        models:
__MODELS_YAML__

- id: agent-default-model
  config:
    provider: omniroute
    model: __MODEL_ID__
