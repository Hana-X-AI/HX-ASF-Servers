# Gordon G7-16 fixture: ACP automation-server composition — the shipped
# examples/acp-agent/cordis.yml leaf rows with the DeepSeek adapter swapped
# for the HX OmniRoute pi-ai route (Morpheus §10 overlay rule). stdout is the
# ACP wire; no logger rows.

- id: llm-pi-ai
  name: '@deepseek-ai/dsh-llm-pi-ai'
  config:
    providers:
      omniroute:
        displayName: OmniRoute (HX qualification route)
        apiKeyEnv: __KEY_ENV__
        api: openai-completions
        baseURL: __BASE_URL__
        compat:
          supportsDeveloperRole: false
          maxTokensField: max_tokens
        retryPolicy:
          mode: normal
          maxRetries: __MAX_RETRIES__
        models:
          - id: __MODEL_ID__
            name: __MODEL_ID__
            contextWindow: 65536
            maxTokens: 8192

# Sandbox + approval posture: scratch workspace, no interactive approval (the
# shipped DSH_PERMISSION_MODE=danger-full-access resolution, made literal for
# this fixture — the nonce task needs no tool call).
- id: sandbox
  name: '@deepseek-ai/dsh-sandbox-local'

- id: sandbox-policy
  name: '@deepseek-ai/dsh-sandbox-policy'
  config:
    mode: danger-full-access
    workspaceRoot: !!js process.cwd()

- id: subprocess
  name: '@deepseek-ai/dsh-subprocess-local'

- id: bash
  name: '@deepseek-ai/dsh-bash-sandbox'
  config:
    timeoutMs: 60000

- id: approval
  name: '@deepseek-ai/dsh-user-approval'
  config:
    policy: never

# The ACP automation app: agent spine + JSONL persistence + protocol bridge.
- id: acp-agent
  name: '@deepseek-ai/dsh-acp-demo'
  config:
    provider: omniroute
    model: __MODEL_ID__
    persistenceRoot: __SESSION_ROOT__
    persistenceCompression: zstd
    workspaceContext:
      maxBytes: 65536
    persona: |
      You are a coding assistant powered by the {{model}} model. Your working directory is {{cwd}}. Keep answers brief and factual.

- id: token-meter
  name: '@deepseek-ai/dsh-token-meter'

- id: compaction-basic
  name: '@deepseek-ai/dsh-compaction-basic'
  config:
    thresholdRatio: 0.8
    retainRatio: 0.08
    maxTokens: 8192
    compactionRetries: 1
