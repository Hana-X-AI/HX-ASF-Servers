# Gordon Phase B fixture: hooks-claude-code bridge with a fixture hooks.json
# (SessionStart echo) + omni route. The bridge is NOT in the CLI resolver
# closure (Morpheus §5: surface inventory only), so the row names the built
# entry by absolute path — the documented raw-config path load.
- insert:
    - id: hooks-claude-code
      name: __DSH_ROOT__/packages/hooks/hooks-claude-code/lib/index.js
      config:
        configPath: __HOOKS_JSON__

- id: llm-pi-ai
  config:
    providers:
      omniroute:
        displayName: OmniRoute (HX qualification route)
        apiKeyEnv: __KEY_ENV__
        api: openai-completions
        baseURL: __BASE_URL__
        compat:
          supportsDeveloperRole: false
          maxTokensField: max_tokens
        retryPolicy:
          mode: normal
          maxRetries: __MAX_RETRIES__
        models:
__MODELS_YAML__

- id: agent-default-model
  config:
    provider: omniroute
    model: __MODEL_ID__
